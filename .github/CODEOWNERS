/force-app/**/lwc/                @your-org/salesforce-engineers
/force-app/**/aura/               @your-org/salesforce-engineers
/force-app/**/flows/              @your-org/salesforce-engineers
/force-app/**/objects/**/fields/  @your-org/salesforce-engineers
/force-app/**/objects/**/validationRules/ @your-org/salesforce-engineers
/force-app/**/objects/*/*.object-meta.xml @your-org/salesforce-engineers

